[MAIN]
load-plugins=pylint.extensions.docparams

[FORMAT]
max-line-length=120
max-module-lines=2500

[MESSAGES CONTROL]
disable=
    C0114,
    C0115,
    C0116,
    C0103,
    C0301,
    R0903,
    R0913,
    R0914,
    W0511,
    W0622,
    W0223,
    E0401,
    W0621,
    R0401,
    C0209,
    W0107,
    R0801,
    C0415,
    W0613,
    R0902,
    W0212,
    C0302,
    R0911,
    W0718,
    W1203,
    R0401,
    C0121,
    R0917

[DESIGN]
max-args=10
max-locals=25
max-returns=8
max-branches=15
max-statements=80
max-attributes=15

[SIMILARITIES]
min-similarity-lines=6

[TYPECHECK]
ignored-modules=numpy,pandas,sklearn,xgboost,lightgbm,shap,plotly,streamlit,torch,fastapi,uvicorn,sqlalchemy

[BASIC]
good-names=i,j,k,v,e,f,x,y,X,df,db,pc,ax,fn,lr,n
